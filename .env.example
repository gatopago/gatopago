# Shared public configuration: keep these values equal in Web and Wallet Core.
# The environment label namespaces protocol records; it does not select URLs.
GATOPAGO_ENVIRONMENT=production
GATOPAGO_WEB_ORIGIN=http://localhost:3000
GATOPAGO_API_ORIGIN=http://localhost:8787
GATOPAGO_BUSINESS_ORIGIN=http://localhost:3000
GATOPAGO_WALLET_NETWORKS=eip155:421614
FIREBASE_PROJECT_ID=proyecto-prueba-push-firebase

# Public Firebase Web app identifiers (not service-account credentials).
GATOPAGO_FIREBASE_WEB_API_KEY=
GATOPAGO_FIREBASE_WEB_APP_ID=
# Cloudflare's documented test widget, accepted only on loopback Web + API.
GATOPAGO_TURNSTILE_SITE_KEY=1x00000000000000000000AA
