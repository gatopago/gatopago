# Public configuration (no secrets).
GATOPAGO_WEB_ORIGIN=http://localhost:3000
GATOPAGO_API_ORIGIN=http://localhost:8787
# CAIP-2 ids of the wallet networks, and the home network (where balances are kept).
GATOPAGO_WALLET_NETWORKS=eip155:421614,eip155:43113,eip155:10143
GATOPAGO_HOME_NETWORK=eip155:421614
# Optional: RPC per network for the browser's reads, e.g. Alchemy keys restricted to this domain
# ({"eip155:421614":"https://arb-sepolia.g.alchemy.com/v2/<key>"}); each falls back to the public RPC.
GATOPAGO_WALLET_RPC_URLS=
# Cloudflare's test widget, which always passes.
GATOPAGO_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional: minutes a Mera signing session lasts without use (default 15).
GATOPAGO_MERA_SESSION_MINUTES=
# Optional: the domain passkeys belong to (default: this site's). Never change it once people have passkeys.
GATOPAGO_PASSKEY_RP_ID=
# Optional: Stellar (stellar:testnet) beside the EVM networks; Wallet Core needs STELLAR_SECRET_KEY too.
# GATOPAGO_STELLAR_RPC_URL optionally replaces the network's public RPC for the browser's reads.
GATOPAGO_STELLAR_NETWORK=
GATOPAGO_STELLAR_RPC_URL=
# Optional: payment notifications. Firebase web app config ({"apiKey","projectId","messagingSenderId","appId"})
# and the Cloud Messaging web push (VAPID) public key.
GATOPAGO_FIREBASE_CONFIG=
GATOPAGO_FIREBASE_VAPID_KEY=
